{
  "name": "dook",
  "version": "0.1.2",
  "private": true,
  "productName": "DOOK",
  "description": "DOOK Windows桌面待办与小记应用",
  "type": "module",
  "main": "out/main/index.js",
  "author": "SEVEN-TSY",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "install-electron --no && electron-vite dev",
    "start": "install-electron --no && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test tests/*.test.ts",
    "build": "npm run typecheck && electron-vite build",
    "smoke": "npm run build && node scripts/run-smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist:win": "npm run build && electron-builder --win nsis",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
